+               bf.header.pid = 9999;
+               bf.header.next_free_bf = nullptr;
+               bf.header.contention_tracker.reset();
+               bf.header.keep_in_memory = false;
+               reclaimCXLBufferFrame(bf);
+
+               final_bf = &dram_bf;
+            } jumpmuCatch() {
