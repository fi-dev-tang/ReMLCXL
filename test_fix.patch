          bf.header.latch.mutex.lock();
          bf.header.latch -> fetch_add(LATCH_EXCLUSIVE_BIT);
          bf.reset();
          bf.header.latch -> fetch_add(LATCH_EXCLUSIVE_BIT, std::memory_order_release);
          bf.header.latch.mutex.unlock();
