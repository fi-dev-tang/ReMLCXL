-         BufferFrame& dram_bf = randomPartition().dram_free_list.tryPop();
-         std::memcpy(&dram_bf.page, &bf.page, PAGE_SIZE);
-         dram_bf.header.last_written_plsn = bf.header.last_written_plsn;
-         dram_bf.header.state = BufferFrame::STATE::LOADED;
-         dram_bf.header.pid = pid;
-         if (FLAGS_crc_check) {
-            dram_bf.header.crc = bf.header.crc;
+         BufferFrame* dram_bf_ptr = nullptr;
+         jumpmuTry()
+         {
+            dram_bf_ptr = &randomPartition().dram_free_list.tryPop();
+         }
+         jumpmuCatch()
+         {
+            // If tryPop fails, we must clean up the io_frame before jumping!
+            // We hold io_frame_lock (JMUW).
+            JMUW<std::unique_lock<std::mutex>> g_guard_cleanup(partition.ht_mutex);
+            if (io_frame.readers_counter.fetch_add(-1) == 1) {
+               partition.io_ht.remove(pid);
+            } else {
+               // Other threads are waiting. We can't just delete it.
+               // Actually, if we set state to TO_DELETE, they will clean it up.
+               io_frame.state = IOFrame::STATE::TO_DELETE;
+            }
+            g_guard_cleanup->unlock();
+            io_frame_lock->unlock();
+            
+            // Also we must reclaim the CXL bf we popped
+            reclaimCXLBufferFrame(bf);
+            jumpmu::jump();
+         }
+         std::memcpy(&dram_bf_ptr->page, &bf.page, PAGE_SIZE);
+         dram_bf_ptr->header.last_written_plsn = bf.header.last_written_plsn;
+         dram_bf_ptr->header.state = BufferFrame::STATE::LOADED;
+         dram_bf_ptr->header.pid = pid;
